{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "sin1"
  ],
  "redirects": [
    {
      "source": "/((?!api/|sw\\.js).*)",
      "has": [
        {
          "type": "host",
          "value": "hatsit.vercel.app"
        }
      ],
      "destination": "https://hatsit.org/$1",
      "permanent": true
    }
  ],
  "functions": {
    "api/mafia-voice.js": {
      "maxDuration": 30
    },
    "api/mafia-story.js": {
      "maxDuration": 15
    },
    "api/cards.js": {
      "maxDuration": 15
    }
  }
}
