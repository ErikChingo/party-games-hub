{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "sin1"
  ],
  "redirects": [
    {
      "source": "/((?!api/|sw\\.js).*)",
      "has": [
        {
          "type": "host",
          "value": "hatsit.vercel.app"
        }
      ],
      "destination": "https://hatsit.org/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/hy",
      "destination": "/seo/hy/index.html"
    },
    {
      "source": "/hy/:slug(nardy|durak|blot|blackjack|mafia|shpion|alias|krokodil|bez-slov|obratnyj-otschet|isporchennyj-telefon|bunker|sud)",
      "destination": "/seo/hy/:slug.html"
    },
    {
      "source": "/:slug(nardy|durak|blot|blackjack|mafia|shpion|alias|krokodil|bez-slov|obratnyj-otschet|isporchennyj-telefon|bunker|sud)",
      "destination": "/seo/:slug.html"
    },
    {
      "source": "/join/:game/:code",
      "destination": "/api/invite?game=:game&code=:code"
    }
  ],
  "functions": {
    "api/mafia-voice.js": {
      "maxDuration": 30
    },
    "api/mafia-story.js": {
      "maxDuration": 15
    },
    "api/cards.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/notify?task=daily",
      "schedule": "0 15 * * *"
    }
  ]
}
